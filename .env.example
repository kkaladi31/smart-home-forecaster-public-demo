# Smart-Home Forecaster — demo build
#
# This repository is the DEMO build: 100% synthetic property data, free
# providers only. The data plane is pinned below and should not be changed —
# every home, HOA, contractor and utility rate in it is invented.

SHF_PROFILE=demo

# The only key you need. Free at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: your own contact address, sent as a User-Agent to the National
# Weather Service, which asks clients to identify themselves.
# CONTACT_EMAIL=you@example.com

# Optional: a free key from https://www.eia.gov/opendata/register.php enables
# live state energy prices. Without it the cost specialist uses published
# averages and says so.
# EIA_API_KEY=
